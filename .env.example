# Токен бота от @BotFather (см. README.md, шаг 1)
TELEGRAM_BOT_TOKEN=

# Токен и marker (партнёрский ID) с travelpayouts.com (см. README.md, шаг 2)
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# Ниже — необязательно, есть разумные значения по умолчанию (см. config.py)
# ORIGINS=MOW,MRV
# DESTINATION=CXR
# CURRENCY=rub

# Фиксированный период конкретной поездки (формат YYYY-MM-DD). Если оба
# заданы — ищем строго в этом окне вместо скользящих SEARCH_WINDOW_DAYS
# от сегодня. start на месте использования подрезается по сегодняшнему дню.
# SEARCH_START_DATE=2026-07-28
# SEARCH_END_DATE=2026-08-07
# SEARCH_WINDOW_DAYS=21

# CHECK_INTERVAL_MINUTES=20
# DEFAULT_BUDGET_RUB=30000
# MAX_DOMESTIC_LEG_RUB=8000
# HUB_MIN_SAVINGS_USD=100
# USD_RUB_RATE=78
# MIN_HUB_LAYOVER_HOURS=6
# MIN_HUB_LAYOVER_DAYS=1
