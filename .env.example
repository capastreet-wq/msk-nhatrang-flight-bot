# Токен бота от @BotFather (см. README.md, шаг 1)
TELEGRAM_BOT_TOKEN=

# Токен и marker (партнёрский ID) с travelpayouts.com (см. README.md, шаг 2)
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# Ниже — необязательно, есть разумные значения по умолчанию (см. config.py)
# ORIGINS=MOW,MRV
# DESTINATIONS=CXR — города назначения через запятую, В ПОРЯДКЕ ПРИОРИТЕТА
#   (первый — самый желанный), например DESTINATIONS=MRV,KRR,ASF,MOW
# CURRENCY=rub

# Фиксированный период конкретной поездки (формат YYYY-MM-DD). Если оба
# заданы — ищем строго в этом окне вместо скользящих SEARCH_WINDOW_DAYS
# от сегодня. start на месте использования подрезается по сегодняшнему дню.
# SEARCH_START_DATE=2026-08-04
# SEARCH_END_DATE=2026-08-15
# SEARCH_WINDOW_DAYS=21

# На сколько дней дальше основного окна фоново смотрим цены ТОЛЬКО для
# медианы рынка (не показываются как варианты для покупки).
# MARKET_CONTEXT_EXTRA_DAYS=10

# CHECK_INTERVAL_MINUTES=20
# DEFAULT_BUDGET_RUB=30000 — порог для пометки 🔥 (просто пометка, всё равно показываем все варианты)
# MAX_PRICE_RUB — ЖЁСТКИЙ потолок цены за человека: варианты дороже вообще не показываем. Пусто = без потолка
# MAX_DOMESTIC_LEG_RUB=8000
# MAX_TRANSFERS=1 — не предлагать билеты (ни один сегмент) больше чем с этим числом пересадок
# MAX_PRICE_AGE_DAYS=5 — отсекать цены из кэша старше этого числа дней (found_at)

# Порог "почти одинаковая цена — предпочитаем по приоритету, не по минимуму":
# и для прямой/хаб, и для выбора между городами из DESTINATIONS.
# PRIORITY_MARGIN_RUB=10000

# ENABLE_HUB_SEARCH=true — выключи (false), если маршрут не связан с Вьетнамом
# MIN_HUB_LAYOVER_HOURS=6
# MIN_HUB_LAYOVER_DAYS=1
# MAX_HUB_LAYOVER_DAYS=3
